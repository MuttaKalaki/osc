<?php
require "db.php";
$result = $conn->query("SELECT id, name, email, message FROM feedback ORDER BY id DESC");
?>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Feedback Details</title></head><body>
<h2>Feedback Details</h2>
<table border="1" cellpadding="8"><tr><th>ID</th><th>Name</th><th>Email</th><th>Message</th></tr>
<?php while ($row = $result->fetch_assoc()): ?>
<tr>
<td><?php echo (int)$row["id"]; ?></td>
<td><?php echo htmlspecialchars($row["name"]); ?></td>
<td><?php echo htmlspecialchars($row["email"]); ?></td>
<td><?php echo htmlspecialchars($row["message"]); ?></td>
</tr>
<?php endwhile; ?>
</table><a href="index.php">Back to Form</a></body></html>

